[Unit]
Description=Cloudflare Tunnel for management app (dntechx.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/management_custom
# Prefer named tunnel config (created by setup-named-tunnel.sh).
# install-cloudflare-tunnel.sh rewrites ExecStart with absolute paths.
ExecStart=%h/Projects/management_custom/docker/bin/cloudflared tunnel --no-autoupdate --config %h/Projects/management_custom/docker/cloudflared/config.yml run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
