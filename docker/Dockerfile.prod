# Latest Node Current on Docker Hub (26.5.0-alpine). Official Node builds still
# ship npm 11.x, and the Alpine image does not include the `corepack` binary.
# Bootstrap Corepack with the image npm, then activate packageManager npm@12.
FROM node:26.5.0-alpine AS builder

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apk add --no-cache python3 make gcc g++ musl-dev \
    && ln -sf python3 /usr/bin/python \
    && npm install -g corepack@0.35.0 \
    && corepack enable \
    && corepack prepare npm@12.0.2 --activate \
    && node -v && npm -v

COPY package.json package-lock.json ./
# Pi / residential links occasionally drop mid-fetch; retry npm ci a few times
# before failing the image build (which would leave the live stack untouched).
RUN set -eu; \
    i=1; \
    until npm ci --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000; do \
      if [ "$i" -ge 4 ]; then \
        echo "npm ci failed after ${i} attempts" >&2; \
        exit 1; \
      fi; \
      echo "npm ci attempt ${i} failed — retrying in $((i * 15))s…"; \
      sleep $((i * 15)); \
      i=$((i + 1)); \
    done

COPY . .
RUN npm run build

FROM node:26.5.0-alpine AS production

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN addgroup -g 1001 -S nodejs \
    && adduser -S nuxt -u 1001 \
    && npm install -g corepack@0.35.0 \
    && corepack enable \
    && corepack prepare npm@12.0.2 --activate \
    && npm install -g tsx@4.23.1 \
    && node -v && npm -v

COPY --from=builder --chown=nuxt:nodejs /app/.output /app/.output
COPY --from=builder --chown=nuxt:nodejs /app/scripts /app/scripts
COPY --from=builder --chown=nuxt:nodejs /app/server/db /app/server/db
COPY --from=builder --chown=nuxt:nodejs /app/package.json /app/package.json
COPY --from=builder --chown=nuxt:nodejs /app/node_modules /app/node_modules
COPY --chown=nuxt:nodejs docker/entrypoint.prod.sh /app/entrypoint.prod.sh

RUN chmod +x /app/entrypoint.prod.sh

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["/app/entrypoint.prod.sh"]
