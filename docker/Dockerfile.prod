# Production image for the Pi (Podman). Optimized for rebuild speed:
# - Early layers (apk / npm) stay cached across deploys via :builder-cache
# - Runtime stage does NOT copy the full node_modules tree (was ~6 min on SD)
# - Nitro `.output` is self-contained; only mysql2+tsx are needed for migrate
#
# Official node images still ship npm 11.x; Alpine omits Corepack. Upgrade npm
# in the *builder* with `npm install -g` so it persists across layers.
FROM node:26.5.0-alpine AS builder

WORKDIR /app

# Skip husky in image builds (.git is not copied into the build context).
ENV HUSKY=0
ENV npm_config_update_notifier=false
ENV npm_config_fund=false
ENV npm_config_audit=false

RUN apk add --no-cache python3 make gcc g++ musl-dev \
    && ln -sf python3 /usr/bin/python \
    && npm install -g npm@12.0.2 \
    && node -v && npm -v

COPY package.json package-lock.json ./
# Pi / residential links occasionally drop mid-fetch; retry npm ci a few times
# before failing the image build (which would leave the live stack untouched).
RUN set -eu; \
    i=1; \
    until npm ci --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000; do \
      if [ "$i" -ge 4 ]; then \
        echo "npm ci failed after ${i} attempts" >&2; \
        exit 1; \
      fi; \
      echo "npm ci attempt ${i} failed — retrying in $((i * 15))s…"; \
      sleep $((i * 15)); \
      i=$((i + 1)); \
    done

COPY . .
RUN npm run build

# ── Runtime ───────────────────────────────────────────────────────────────
FROM node:26.5.0-alpine AS production

WORKDIR /app

ENV HUSKY=0
ENV npm_config_update_notifier=false
ENV npm_config_fund=false
ENV npm_config_audit=false

RUN addgroup -g 1001 -S nodejs \
    && adduser -S nuxt -u 1001 \
    && node -v && npm -v

# Migrate / DB-wait need local mysql2 + tsx (`node --import tsx` resolves
# from /app/node_modules — a global install is not enough). Do NOT copy
# builder node_modules (hundreds of MB → multi-minute COPY on the Pi SD).
COPY docker/runtime-package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force \
    && node --import tsx -e "console.log('tsx ok')"

COPY --from=builder --chown=nuxt:nodejs /app/.output /app/.output
COPY --from=builder --chown=nuxt:nodejs /app/scripts /app/scripts
COPY --from=builder --chown=nuxt:nodejs /app/server/db /app/server/db
COPY --chown=nuxt:nodejs docker/entrypoint.prod.sh /app/entrypoint.prod.sh

RUN chmod +x /app/entrypoint.prod.sh

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["/app/entrypoint.prod.sh"]

# Node 26 has native fetch — no curl/wget package needed on the slim runtime.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
