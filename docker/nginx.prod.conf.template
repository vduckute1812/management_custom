events {
    worker_connections 1024;
}

http {
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=app:10m rate=30r/s;

    # Cloudflare Tunnel sets X-Forwarded-Proto; fall back for LAN access.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    server {
        listen 80;
        server_name dntechx.com www.dntechx.com localhost _;

        # Largest allowed upload is 10MB (see utils/uploadPolicy.ts); the extra
        # 1M covers multipart boundaries and part headers so the app returns a
        # readable 400 instead of nginx cutting the request off with a bare 413.
        client_max_body_size 11M;

        # Chat SSE (inbox badge + open thread). Must win over `location /api/`.
        # Default /api/ uses HTTP/1.0 + buffering + 60s read timeout, which
        # turns long-lived EventSource streams into 504s (esp. via Cloudflare).
        location ~ ^/api/chat/(inbox/stream|conversations/[^/]+/stream)$ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }

        location /api/ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_hide_header Cache-Control;
            add_header Cache-Control "no-store" always;
        }

        # Hashed build assets — keep Nuxt's immutable Cache-Control.
        location ^~ /_nuxt/ {
            limit_req zone=app burst=50 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
        }

        location / {
            limit_req zone=app burst=50 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            # Prevent stale SPA shells after deploy (old /_nuxt hashes → Nuxt 500).
            proxy_hide_header Cache-Control;
            add_header Cache-Control "no-store" always;
        }

        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name dntechx.com www.dntechx.com localhost _;

        ssl_certificate /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        ssl_session_timeout 1d;
        ssl_session_cache shared:mgmtSSL:10m;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # Largest allowed upload is 10MB (see utils/uploadPolicy.ts); the extra
        # 1M covers multipart boundaries and part headers so the app returns a
        # readable 400 instead of nginx cutting the request off with a bare 413.
        client_max_body_size 11M;

        # Chat SSE — see matching block on :80 above.
        location ~ ^/api/chat/(inbox/stream|conversations/[^/]+/stream)$ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }

        location /api/ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_hide_header Cache-Control;
            add_header Cache-Control "no-store" always;
        }

        # Hashed build assets — keep Nuxt's immutable Cache-Control.
        location ^~ /_nuxt/ {
            limit_req zone=app burst=50 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
        }

        location / {
            limit_req zone=app burst=50 nodelay;
            proxy_pass http://__LAN_IP__:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_hide_header Cache-Control;
            add_header Cache-Control "no-store" always;
        }

        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }
}
