# Copy this file to `.env` and fill in real values.

# ── MySQL ────────────────────────────────────────────────────────────────
# Read by server/utils/db.ts at startup.
DB_HOST=127.0.0.1
DB_PORT=3306
# Prefer a dedicated app user over root in production. The official MySQL
# image creates MYSQL_USER/MYSQL_PASSWORD on first volume init; for an
# existing volume run the grants as root once, then point DB_USER/DB_PASS
# here. Root remains available as MYSQL_ROOT_PASSWORD for migrate/admin.
DB_USER=root
DB_PASS=
DB_NAME=rc

# Pool size. 10 is comfortable for a single-user local app.
DB_CONNECTION_LIMIT=10

# Production only (docker/.env.prod): root password for the mysql container,
# read by docker/docker-compose.prod.yml. Keep it equal to DB_PASS above.
# MYSQL_ROOT_PASSWORD=


# ── Auth ─────────────────────────────────────────────────────────────────
# Signing key for JWT access tokens. MUST be at least 16 characters and
# kept secret — leaking it lets an attacker mint admin tokens. Generate one
# with: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-long-random-string

# Auth cookies (`mgmt_rt` refresh, `mgmt_at` access). Default: Secure when
# NODE_ENV=production or APP_BASE_URL is https. Set COOKIE_SECURE=false for
# plain http://localhost if the browser rejects Secure cookies.
# COOKIE_SECURE=false

# Seed admin created by `npm run migrate:auth`. Pick any password you like;
# you can change it later through the app once logged in. The migration is
# idempotent — once the user exists these are ignored.
ADMIN_INITIAL_EMAIL=admin@local
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Administrator


# ── SMTP (optional) ──────────────────────────────────────────────────────
# Used to send email-verification links. If any of the three required
# fields is blank, the mailer falls back to printing the email to the
# server console so you can copy the verification link by hand in dev.
#
# For Gmail: use an "App password" (Google account → Security → App
# passwords), NOT your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Email address notified when the router public IP changes (production:
# docker/.env.prod). Defaults to SMTP_FROM, then SMTP_USER.
# IP_CHANGE_NOTIFY_EMAIL=you@example.com


# ── App ──────────────────────────────────────────────────────────────────
# Where this app is reachable from the user's browser. Used to build the
# absolute URL inside verification emails.
#
# Prefer APP_BASE_URL when the app sits behind a reverse proxy or Cloudflare
# Tunnel — it wins over APP_HOST / APP_PORT / APP_PROTOCOL.
# APP_BASE_URL=https://dntechx.com
#
# Cloudflare R2 (S3-compatible) for feed/story uploads — required for Attach.
# Create an R2 bucket + API token with Object Read & Write in the CF dashboard.
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=mgmt-uploads
# Optional override (defaults to https://{accountId}.r2.cloudflarestorage.com):
# R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
# Signed GET URL lifetime in seconds (default 3600):
# R2_SIGNED_URL_TTL=3600
#
# ── Cache (optional Redis) ───────────────────────────────────────────────
# Default driver is in-process memory. Set REDIS_URL to share cache across
# app instances. CACHE_DRIVER=memory forces memory even when Redis is set.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_DRIVER=memory
# CACHE_NAMESPACE=rc
# CACHE_MEMORY_MAX=500
#
# ── Background job queue ─────────────────────────────────────────────────
# MySQL-backed durable queue (table `jobs`). Worker runs inside Nitro.
# QUEUE_WORKER_ENABLED=true
# QUEUE_POLL_MS=1500
# QUEUE_IDLE_MS=4000
# QUEUE_STALE_SECONDS=300
# QUEUE_PURGE_DAYS=14
#
# Otherwise the URL is built from the parts below. The port is omitted when it
# matches the protocol default (80 for http, 443 for https).
# APP_PROTOCOL` is optional and defaults to `http`.
APP_HOST=localhost
APP_PORT=3000
# APP_PROTOCOL=http
