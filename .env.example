# Copy this file to `.env` and fill in real values.
# Prefer Doppler for shared secrets: `npm run secrets:pull` or `npm run dev:doppler`
# (see implement/doppler.md). Production Pi downloads Doppler config `prd` only —
# missing required keys fail the deploy (no local .env.prod fallback).

# ── MySQL ────────────────────────────────────────────────────────────────
# Read by server/utils/db.ts at startup.
DB_HOST=127.0.0.1
DB_PORT=3306
# Prefer a dedicated app user over root in production:
#   1. Edit password in docker/mysql-create-app-user.sql (replace CHANGE_ME)
#   2. Apply as root: mysql -uroot -p < docker/mysql-create-app-user.sql
#   3. Set DB_USER=mgmt and DB_PASS=<same password>
#   4. Remove ALLOW_ROOT_DB from Doppler / env
# Local/dev may keep root. In NODE_ENV=production the app refuses DB_USER=root
# unless ALLOW_ROOT_DB=1 (escape hatch only — cut over ASAP).
DB_USER=root
DB_PASS=
DB_NAME=rc
# ALLOW_ROOT_DB=1

# Optional: MySQL integration tests (`DB_INTEGRATION=1 npm run test:integration`).
# Use a migrated throwaway database — never production.
# DB_INTEGRATION=1
# DB_NAME=rc_test

# Pool size. 10 is comfortable for a single-user local app.
DB_CONNECTION_LIMIT=10

# Production only (docker/.env.prod): root password for the mysql container,
# read by docker/docker-compose.prod.yml. Keep it equal to DB_PASS above.
# MYSQL_ROOT_PASSWORD=


# ── Auth ─────────────────────────────────────────────────────────────────
# Signing key for JWT access tokens. MUST be at least 32 characters and
# kept secret — leaking it lets an attacker mint admin tokens. Generate one
# with: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-long-random-string

# Auth cookies (`mgmt_rt` refresh, `mgmt_at` access). Default: Secure when
# NODE_ENV=production or APP_BASE_URL is https. Set COOKIE_SECURE=false for
# plain http://localhost if the browser rejects Secure cookies.
# COOKIE_SECURE=false

# Seed admin created by `npm run migrate:auth`. Pick any password you like;
# you can change it later through the app once logged in. The migration is
# idempotent — once the user exists these are ignored.
ADMIN_INITIAL_EMAIL=admin@local
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Administrator

# Google OAuth (optional). When both are set, login/signup show “Continue with
# Google” and Settings can link/unlink. Create an OAuth 2.0 Web client in
# Google Cloud Console; authorized redirect URI must match exactly:
#   {APP_BASE_URL}/api/auth/google/callback
# e.g. https://dntechx.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override (defaults to APP_BASE_URL + /api/auth/google/callback):
# GOOGLE_REDIRECT_URI=


# ── SMTP (optional) ──────────────────────────────────────────────────────
# Used to send email-verification links. If any of the three required
# fields is blank, the mailer falls back to printing the email to the
# server console so you can copy the verification link by hand in dev.
#
# For Gmail: use an "App password" (Google account → Security → App
# passwords), NOT your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Email address notified when the router public IP changes (production:
# docker/.env.prod). Defaults to SMTP_FROM, then SMTP_USER.
# IP_CHANGE_NOTIFY_EMAIL=you@example.com


# ── App ──────────────────────────────────────────────────────────────────
# Where this app is reachable from the user's browser. Used to build the
# absolute URL inside verification emails.
#
# Prefer APP_BASE_URL when the app sits behind a reverse proxy or Cloudflare
# Tunnel — it wins over APP_HOST / APP_PORT / APP_PROTOCOL.
# APP_BASE_URL=https://dntechx.com
#
# Cloudflare R2 (S3-compatible) for feed/story uploads — required for Attach.
# Create an R2 bucket + API token with Object Read & Write in the CF dashboard.
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=mgmt-uploads
# Optional override (defaults to https://{accountId}.r2.cloudflarestorage.com):
# R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
# Signed GET URL lifetime in seconds (default 3600):
# R2_SIGNED_URL_TTL=3600
#
# ── Cache (Redis in production) ──────────────────────────────────────────
# Local/dev: leave REDIS_URL unset → in-process memory driver.
# Production compose sets REDIS_URL + CACHE_DRIVER=redis to the Pi LAN bind
# (see docker/docker-compose.prod.yml). CACHE_DRIVER=memory forces memory
# even when Redis is set (not used in prod compose).
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_DRIVER=memory
# CACHE_NAMESPACE=rc
# CACHE_MEMORY_MAX=500
# Production Redis auth (docker-compose.prod.yml --requirepass). REQUIRED in
# prod — compose refuses to start without it. Generate with:
#   openssl rand -base64 32
# Do not use weak placeholders such as "changeme".
# REQUIRED in Doppler config prd — deploy fails if missing/empty.
# REDIS_PASSWORD=
#
# ── Background job queue ─────────────────────────────────────────────────
# MySQL-backed durable queue (table `jobs`). Worker runs inside Nitro.
# QUEUE_WORKER_ENABLED=true
# QUEUE_CONCURRENCY=2
# QUEUE_POLL_MS=1500
# QUEUE_IDLE_MS=4000
# QUEUE_STALE_SECONDS=300
# QUEUE_PURGE_DAYS=14
#
# ── Article content pipeline (AI rewrite + admin review) ─────────────────
# Daily fetch runs inside the Nitro job worker after ARTICLES_FETCH_HOUR_UTC.
# Prefers reputable feeds; expands short RSS bodies by fetching the article page.
# ARTICLES_FETCH_ENABLED=true
# ARTICLES_FETCH_HOUR_UTC=2
# ARTICLES_FETCH_MAX_PER_SOURCE=1
# ARTICLES_FETCH_MIN_CHARS=800
# ARTICLES_EXPAND_PAGES=true
# ARTICLES_EXPAND_BELOW_CHARS=1500
# Concise AI summaries (~3 minute read). Source link is appended by the pipeline.
# ARTICLES_READ_MINUTES_MIN=2
# ARTICLES_READ_MINUTES_MAX=3
#
# LLM provider: gemini (default) or openai
# Prefer Flash-Lite for cost (~10x cheaper than Flash). Free tier: AI Studio rate limits.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MAX_OUTPUT_TOKENS=4096
# LLM_TIMEOUT_MS=120000
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=4000
#
# Otherwise the URL is built from the parts below. The port is omitted when it
# matches the protocol default (80 for http, 443 for https).
# APP_PROTOCOL` is optional and defaults to `http`.
APP_HOST=localhost
APP_PORT=3000
# APP_PROTOCOL=http
